MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=

# URL pública usada em pagamentos e tarefas agendadas.
APP_URL=
# Domínio canônico usado apenas por `pnpm worker:production`.
PRODUCTION_APP_URL=https://www.artgian.com.br

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_BACKUP_DATABASE_NAME=
BACKUP_AGE_RECIPIENT=

# Melhor Envio: use sandbox até validar todo o checkout.
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_ACCESS_TOKEN=
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=
MELHOR_ENVIO_USER_AGENT=Empresa (seu-email-de-suporte@exemplo.com)

# Compra de etiquetas: funcionalidade bloqueada por código fora do sandbox.
MELHOR_ENVIO_SENDER_NAME=
MELHOR_ENVIO_SENDER_EMAIL=
MELHOR_ENVIO_SENDER_PHONE=
MELHOR_ENVIO_SENDER_DOCUMENT=
MELHOR_ENVIO_SENDER_ADDRESS=
MELHOR_ENVIO_SENDER_NUMBER=
MELHOR_ENVIO_SENDER_COMPLEMENT=
MELHOR_ENVIO_SENDER_DISTRICT=
MELHOR_ENVIO_SENDER_CITY=
MELHOR_ENVIO_SENDER_STATE=SP

# Proteção HTTP Basic da área /admin.
ADMIN_USERNAME=artgian
ADMIN_PASSWORD=

# Assistente comercial local
DATABASE_URL=file:./data/artgian.db
COMMERCIAL_DATABASE_MODE=local
COMMERCIAL_DEMO_MODE=true
# JSON integral de config/business.json para inicializar ambientes sem filesystem persistente.
BUSINESS_CONFIG_JSON=

# OpenAI: chamadas reais ficam bloqueadas sem orçamento e custos configurados.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MONTHLY_BUDGET_USD=
OPENAI_INPUT_COST_PER_1M_USD=0.20
OPENAI_OUTPUT_COST_PER_1M_USD=1.20

# Chrome dedicado via CDP. Nunca use o perfil pessoal.
CHROME_CDP_URL=
CHROME_PROFILE_DIR=.chrome-profile
# Descoberta segura: lê sinais públicos e cria leads para revisão, sem enviar DM.
INSTAGRAM_DISCOVERY_ENABLED=false
MAX_DISCOVERY_PROFILES_PER_RUN=10
# Cadência da leitura e pesquisa no navegador dedicado.
DISCOVERY_MIN_ACTION_DELAY_SECONDS=2
DISCOVERY_MAX_ACTION_DELAY_SECONDS=5
DISCOVERY_MIN_RESULTS_WAIT_SECONDS=4
DISCOVERY_MAX_RESULTS_WAIT_SECONDS=8
DISCOVERY_MIN_SECONDS_BETWEEN_SEARCHES=6
DISCOVERY_MAX_SECONDS_BETWEEN_SEARCHES=14
DISCOVERY_MIN_PROFILE_DWELL_SECONDS=6
DISCOVERY_MAX_PROFILE_DWELL_SECONDS=14
DISCOVERY_MIN_SECONDS_BETWEEN_PROFILES=8
DISCOVERY_MAX_SECONDS_BETWEEN_PROFILES=20
# Segunda trava obrigatória. Somente true após dry-run e autorização explícita.
BROWSER_SEND_ENABLED=false
BROWSER_TYPING_MIN_DELAY_MS=85
BROWSER_TYPING_MAX_DELAY_MS=170
OUTBOUND_MIN_PROFILE_DWELL_SECONDS=5
OUTBOUND_MAX_PROFILE_DWELL_SECONDS=12
OUTBOUND_MIN_ACTION_DELAY_SECONDS=2
OUTBOUND_MAX_ACTION_DELAY_SECONDS=5
OUTBOUND_MIN_SECONDS_BEFORE_SEND=3
OUTBOUND_MAX_SECONDS_BEFORE_SEND=7
OUTBOUND_MIN_SECONDS_AFTER_SEND=2
OUTBOUND_MAX_SECONDS_AFTER_SEND=4

# Instagram oficial
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Vercel Cron envia este segredo no header Authorization.
CRON_SECRET=

# QStash acorda cada follow-up no horário individual. As chaves de assinatura
# são obrigatórias para que a rota aceite a chamada.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Outbound permanece desativado até validação e autorização explícita.
OUTBOUND_AUTOMATION_ENABLED=false
MAX_DMS_PER_DAY=5
MIN_SECONDS_BETWEEN_DMS=300
MAX_SECONDS_BETWEEN_DMS=900
OUTBOUND_FAILURE_THRESHOLD=3
OUTBOUND_OPT_OUT_MIN_SAMPLE=5
OUTBOUND_OPT_OUT_RATE_THRESHOLD=0.2
OUTBOUND_WARMUP_STARTED_AT=
OUTBOUND_WARMUP_START_DAILY=5
OUTBOUND_WARMUP_WEEKLY_INCREASE=5

# Respostas automáticas são apenas para DMs inbound de baixo risco.
# Ative somente após o teste supervisionado e mantenha a pausa no painel como kill switch.
INSTAGRAM_AUTO_REPLY_ENABLED=false
MAX_AUTO_REPLIES_PER_DAY=20
# A API envia o texto inteiro; este intervalo simula o tempo de leitura e composição.
AUTO_REPLY_MIN_DELAY_SECONDS=12
AUTO_REPLY_MAX_DELAY_SECONDS=35

# Follow-ups conservadores: sempre preparados para revisão dentro da janela de 24h.
FOLLOWUP_REVIEW_ENABLED=false
MAX_FOLLOWUPS=1
FOLLOWUP_INTERVAL_HOURS=18

OPERATING_HOURS=09:00-18:00
OPERATING_TIMEZONE=America/Sao_Paulo
