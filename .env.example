MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=

APP_URL=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Melhor Envio: use sandbox até validar todo o checkout.
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_ACCESS_TOKEN=
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=
MELHOR_ENVIO_USER_AGENT=Empresa (seu-email-de-suporte@exemplo.com)

# Compra de etiquetas: funcionalidade bloqueada por código fora do sandbox.
MELHOR_ENVIO_SENDER_NAME=
MELHOR_ENVIO_SENDER_EMAIL=
MELHOR_ENVIO_SENDER_PHONE=
MELHOR_ENVIO_SENDER_DOCUMENT=
MELHOR_ENVIO_SENDER_ADDRESS=
MELHOR_ENVIO_SENDER_NUMBER=
MELHOR_ENVIO_SENDER_COMPLEMENT=
MELHOR_ENVIO_SENDER_DISTRICT=
MELHOR_ENVIO_SENDER_CITY=
MELHOR_ENVIO_SENDER_STATE=SP

# Proteção HTTP Basic da área /admin.
ADMIN_USERNAME=artgian
ADMIN_PASSWORD=

# Assistente comercial local
DATABASE_URL=file:./data/artgian.db
COMMERCIAL_DATABASE_MODE=local
COMMERCIAL_DEMO_MODE=true

# OpenAI: chamadas reais ficam bloqueadas sem orçamento e custos configurados.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_FAST=
OPENAI_MONTHLY_BUDGET_USD=
OPENAI_INPUT_COST_PER_1M_USD=
OPENAI_OUTPUT_COST_PER_1M_USD=

# Chrome dedicado via CDP. Nunca use o perfil pessoal.
CHROME_CDP_URL=
CHROME_PROFILE_DIR=.chrome-profile

# Instagram oficial
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v26.0

# Outbound permanece desativado até validação e autorização explícita.
OUTBOUND_AUTOMATION_ENABLED=false
MAX_OUTBOUND_CONTACTS_PER_DAY=5
MIN_SECONDS_BETWEEN_OUTBOUND=300
MAX_SECONDS_BETWEEN_OUTBOUND=900

# Follow-ups conservadores
MAX_FOLLOWUPS=2
FOLLOWUP_INTERVAL_HOURS=48

OPERATING_HOURS=09:00-18:00
OPERATING_TIMEZONE=America/Sao_Paulo
